.DS_Store
.venv/
__pycache__/
*.pyc
.env
# /output/daily/*.html  # allowed — pushed daily by run_daily.sh
/output/cv/*
/output/documents/*
/output/web/*
# Personal Coach sub-app build is a deployed artifact — keep it tracked.
!/output/web/coach
!/output/**/.gitkeep
/memory/session-log.jsonl
# memory/seen-items.json is NOT ignored: the pipeline runs in GitHub
# Actions on a fresh checkout, so the novelty history has to be in the
# repo or prioritize_unseen has nothing to compare against.
/tmp/

# Personal Coach (Vite sub-app) — track source, ignore install/build cruft.
/coach/node_modules/
/coach/dist/

# Playwright MCP scratch output
.playwright-mcp/
